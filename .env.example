# ── LLM provider (at least one required for the AI chat) ─────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── LLM selection ─────────────────────────────────────────────────────────
LLM_MODEL_ID=anthropic:claude-3-5-sonnet-20241022
EMBEDDING_MODEL=openai:text-embedding-3-small

# ── Cube.js ───────────────────────────────────────────────────────────────
CUBEJS_API_SECRET=demo-secret-change-me
CUBEJS_SQL_PASSWORD=

# ── Superset ──────────────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=demo-superset-key-change-me

# ── FastAPI / Streamlit security ──────────────────────────────────────────
SECRET_KEY=change-me-in-production
FAST_API_ACCESS_SECRET_TOKEN=change-me-in-production
STREAMLIT_PASSWORD=

# ── Milvus (vector store) ─────────────────────────────────────────────────
MILVUS_SERVER_URI=http://milvus-standalone:19530

# ── Cube connection for RAG ───────────────────────────────────────────────
CUBE_URL=http://cube_api:4000
CUBE_SQL_HOST=cube_api
CUBE_SQL_PORT=15432
CUBE_SQL_DATABASE=db
CUBE_SQL_USER=root

# ── FastAPI URL for the chat UI ───────────────────────────────────────────
FASTAPI_URL=http://fastapi:8080

# ── Deployment environment ────────────────────────────────────────────────
DEPLOY_ENV=local
